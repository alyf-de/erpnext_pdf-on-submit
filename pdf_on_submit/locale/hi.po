#: pdf_on_submit/pdf_on_submit/doctype/enabled_doctype/enabled_doctype.json:74
msgid "Attach To Field"
msgstr "फ़ील्ड से जोड़ें"

#. Label of the create_pdf_in_background (Check) field in DocType 'PDF on
#. Submit Settings'
#: pdf_on_submit/pdf_on_submit/doctype/pdf_on_submit_settings/pdf_on_submit_settings.json:29
msgid "Create PDF In Background"
msgstr "पृष्ठभूमि में PDF बनाएं"

#: pdf_on_submit/attach_pdf.py:95
msgid "Creating PDF ..."
msgstr "PDF बनाया जा रहा है ..."

#. Description of the 'Show PDF Button' (Check) field in DocType 'PDF on Submit
#. Settings'
#: pdf_on_submit/pdf_on_submit/doctype/pdf_on_submit_settings/pdf_on_submit_settings.json:43
msgid "Displays a PDF button on the Form View for each enabled DocType."
msgstr "प्रत्येक सक्षम दस्तावेज़ प्रकार के फ़ॉर्म व्यू पर एक PDF बटन प्रदर्शित करता है।"

#. Name of a DocType
#: pdf_on_submit/pdf_on_submit/doctype/enabled_doctype/enabled_doctype.json:83
msgid "Enabled DocType"
msgstr "सक्षम DocType"

#. Label of the enabled_for (Table) field in DocType 'PDF on Submit Settings'
#: pdf_on_submit/pdf_on_submit/doctype/pdf_on_submit_settings/pdf_on_submit_settings.json:34
msgid "Enabled For"
msgstr "के लिए सक्षम"

#: pdf_on_submit/attach_pdf.py:121
#, python-brace-format
msgid "Failed to attach XML to PDF for {0} {1}"
msgstr "{0} {1} के PDF में XML संलग्न करने में विफल"

#: pdf_on_submit/public/js/pdf_button_utils.js:84
#, python-brace-format
msgid "Failed to generate PDF. {0}"
msgstr "PDF बनाने में विफल। {0}"

#. Description of the 'Attach To Field' (Select) field in DocType 'Enabled
#. DocType'
#: pdf_on_submit/pdf_on_submit/doctype/enabled_doctype/enabled_doctype.json:71
msgid ""
"If set, the PDF will be stored in this specific Attach field. If not set, it will be attached to the document without a specific field.<br>\n"
"<b>Note:</b> The Attach fields should be 'No Copy' and 'Read Only'. Otherwise they get overwritten on submit."
msgstr "यदि सेट किया गया है, तो PDF इस विशिष्ट अटैच फ़ील्ड में संग्रहीत किया जाएगा। यदि सेट नहीं किया गया है, तो इसे किसी विशिष्ट फ़ील्ड के बिना दस्तावेज़ से संलग्न किया जाएगा।<br>\n"
"<b>नोट:</b> अटैच फ़ील्ड 'कोई प्रतिलिपि नहीं' और 'केवल पढ़ने के लिए' होने चाहिए। अन्यथा जमा करने पर वे अधिलेखित हो जाएंगे।"

#: pdf_on_submit/public/js/pdf_button_utils.js:75
msgid "More formats are configured for this document. Click to open:"
msgstr "इस दस्तावेज़ के लिए और फ़ॉर्मेट कॉन्फ़िगर किए गए हैं। खोलने के लिए क्लिक करें:"

#. Description of the 'Auto Name' (Data) field in DocType 'Enabled DocType'
#: pdf_on_submit/pdf_on_submit/doctype/enabled_doctype/enabled_doctype.json:28
#, python-brace-format
msgid ""
"Naming Options:\n"
"<ol><li><b>format:EXAMPLE-{MM}-{fieldname1}-{fieldname2}-{#####}</b> - Replace all braced words (fieldnames, date words (DD, MM, YY), series) with their value. Outside braces, any characters can be used.</li></ol>"
msgstr ""
"नामकरण विकल्प:\n"
"<ol><li><b>format:EXAMPLE-{MM}-{fieldname1}-{fieldname2}-{#####}</b> - घुंघराले कोष्ठकों में लिखे सभी शब्दों (फ़ील्ड नाम, दिनांक शब्द (DD, MM, YY), श्रृंखला) को उनके संगत मान से बदलें। कोष्ठकों के बाहर किसी भी वर्ण का उपयोग किया जा सकता है।</li></ol>"

#: pdf_on_submit/utils.py:29
msgid "No permission to print this document"
msgstr "इस दस्तावेज़ को प्रिंट करने की अनुमति नहीं है"

#. Content of the 'filter_description' (HTML) field in DocType 'Enabled
#. DocType'
#: pdf_on_submit/pdf_on_submit/doctype/enabled_doctype/enabled_doctype.json:68
msgid "Optional: create PDF only if the submitted document matches these filters.<br><br>"
msgstr "वैकल्पिक: PDF केवल तभी बनाएं जब सबमिट किया गया दस्तावेज़ इन फ़िल्टर से मेल खाता हो।<br><br>"

#. Name of a DocType
#: pdf_on_submit/pdf_on_submit/doctype/pdf_on_submit_settings/pdf_on_submit_settings.json:55
msgid "PDF on Submit Settings"
msgstr "सबमिट पर PDF सेटिंग्स"

#: pdf_on_submit/public/js/pdf_button_utils.js:44
msgid "Please allow popups for this site and try again."
msgstr "कृपया इस साइट के लिए पॉपअप की अनुमति दें और पुनः प्रयास करें।"

#: pdf_on_submit/public/js/pdf_button_utils.js:85
msgid "Please check your permissions and try again."
msgstr "कृपया अपनी अनुमतियाँ जाँचें और पुनः प्रयास करें।"

#: pdf_on_submit/public/js/pdf_button_utils.js:42
msgid "Popup Blocked"
msgstr "पॉपअप अवरुद्ध"

#: pdf_on_submit/pdf_on_submit/doctype/pdf_on_submit_settings/pdf_on_submit_settings.py:16
#, python-brace-format
