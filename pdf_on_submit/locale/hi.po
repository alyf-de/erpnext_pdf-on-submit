msgstr "पंक्ति #{0}: <b>{1}</b> के लिए अमान्य फ़िल्टर: {2}"

#. Label of the show_pdf_button (Check) field in DocType 'PDF on Submit
#. Settings'
#: pdf_on_submit/pdf_on_submit/doctype/pdf_on_submit_settings/pdf_on_submit_settings.json:46
msgid "Show PDF Button"
msgstr "PDF बटन दिखाएँ"

