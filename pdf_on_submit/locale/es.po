msgstr "Crear PDF en segundo plano"

#: pdf_on_submit/attach_pdf.py:80
msgid "Creating PDF ..."
msgstr "Creando PDF ..."

#. Name of a DocType
#: pdf_on_submit/pdf_on_submit/doctype/enabled_doctype/enabled_doctype.json
msgid "Enabled DocType"
msgstr "DocType habilitado"

#. Label of the enabled_for (Table) field in DocType 'PDF on Submit Settings'
