#: pdf_on_submit/attach_pdf.py:90
msgid "Creating PDF ..."
msgstr "正在创建 PDF ..."

#. Name of a DocType
#: pdf_on_submit/pdf_on_submit/doctype/enabled_doctype/enabled_doctype.json
msgid "Enabled DocType"
msgstr "已启用的DocType"

#. Label of a Table field in DocType 'PDF on Submit Settings'
