msgid "Create PDF In Background"
msgstr "在后台创建PDF"

#: pdf_on_submit/attach_pdf.py:95
msgid "Creating PDF ..."
msgstr "正在创建 PDF ..."

#. Description of the 'Show PDF Button' (Check) field in DocType 'PDF on Submit
#. Settings'
#: pdf_on_submit/pdf_on_submit/doctype/pdf_on_submit_settings/pdf_on_submit_settings.json:43
msgid "Displays a PDF button on the Form View for each enabled DocType."
msgstr "在每个已启用文档类型的表单视图中显示 PDF 按钮。"

#. Name of a DocType
#: pdf_on_submit/pdf_on_submit/doctype/enabled_doctype/enabled_doctype.json:83
msgid "Enabled DocType"
msgstr "已启用的DocType"

#. Label of the enabled_for (Table) field in DocType 'PDF on Submit Settings'
#: pdf_on_submit/pdf_on_submit/doctype/pdf_on_submit_settings/pdf_on_submit_settings.json:34
msgid "Enabled For"
msgstr "启用对象"

#: pdf_on_submit/attach_pdf.py:121
#, python-brace-format
msgid "Failed to attach XML to PDF for {0} {1}"
msgstr "无法将XML附加到 {0} {1} 的PDF中"

#: pdf_on_submit/public/js/pdf_button_utils.js:84
#, python-brace-format
msgid "Failed to generate PDF. {0}"
msgstr "生成 PDF 失败。{0}"

#. Description of the 'Attach To Field' (Select) field in DocType 'Enabled
#. DocType'
#: pdf_on_submit/pdf_on_submit/doctype/enabled_doctype/enabled_doctype.json:71
msgid ""
"If set, the PDF will be stored in this specific Attach field. If not set, it will be attached to the document without a specific field.<br>\n"
"<b>Note:</b> The Attach fields should be 'No Copy' and 'Read Only'. Otherwise they get overwritten on submit."
msgstr "如果设置，PDF将存储在此特定附件字段中。如果未设置，则将附加到单据上而不指定字段。<br>\n"
"<b>注意：</b>附件字段应设置为“不复制”和“只读”。否则，提交时它们将被覆盖。"

#: pdf_on_submit/public/js/pdf_button_utils.js:75
msgid "More formats are configured for this document. Click to open:"
msgstr "此文档还配置了其他格式。点击打开："

#. Description of the 'Auto Name' (Data) field in DocType 'Enabled DocType'
#: pdf_on_submit/pdf_on_submit/doctype/enabled_doctype/enabled_doctype.json:28
#, python-brace-format
msgid ""
"Naming Options:\n"
"<ol><li><b>format:EXAMPLE-{MM}-{fieldname1}-{fieldname2}-{#####}</b> - Replace all braced words (fieldnames, date words (DD, MM, YY), series) with their value. Outside braces, any characters can be used.</li></ol>"
msgstr ""
"命名选项：\n"
"<ol><li><b>format:EXAMPLE-{MM}-{fieldname1}-{fieldname2}-{#####}</b> - 将所有花括号中的词（字段名、日期词（DD、MM、YY）、序列）替换为其对应的值。在花括号之外，可以使用任意字符。</li></ol>"

#: pdf_on_submit/utils.py:29
msgid "No permission to print this document"
msgstr "无权打印此文档"

#. Content of the 'filter_description' (HTML) field in DocType 'Enabled
#. DocType'
#: pdf_on_submit/pdf_on_submit/doctype/enabled_doctype/enabled_doctype.json:68
msgid "Optional: create PDF only if the submitted document matches these filters.<br><br>"
msgstr "可选：仅当已提交的文档符合这些筛选条件时才创建PDF。<br><br>"

#. Name of a DocType
#: pdf_on_submit/pdf_on_submit/doctype/pdf_on_submit_settings/pdf_on_submit_settings.json:55
msgid "PDF on Submit Settings"
msgstr "提交时PDF设置"

